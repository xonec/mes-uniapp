export type ScanBarcodeOptions = {
  /**
   * 图像的本地路径 (支持 uni-app 的相对路径/临时路径等)
   */
  imagePath: string;
  success?: (res: ScanResult) => void;
  fail?: (err: ErrorResult) => void;
}

export type ScanResult = {
  barcodes: Array<BarcodeData>;
}

export type BarcodeData = {
  rawValue: string;
  format: number;
  valueType: number;
}

export type ErrorResult = {
  message: string;
}
