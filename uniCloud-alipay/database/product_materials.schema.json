{
    "bsonType": "object",
    "description": "产品编码唯一的产品基本信息及起始材料档案。包装规格固定；不同客户/订单的材料、上托由包装方案和订单快照分别保存。",
    "required": [
        "productCode",
        "materials"
    ],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "固定为 mat:<产品编码>，主键唯一，一个产品只有一份物料清单"
        },
        "productCode": {
            "bsonType": "string",
            "title": "产品编码",
            "description": "指令单『产品编码』列，如 1306005276"
        },
        "productName": {
            "bsonType": "string",
            "title": "产品名称",
            "description": "指令单『产品名称』列，如 SWISSE® 乳清蛋白粉"
        },
        "packSpec": {
            "bsonType": "string",
            "title": "包装规格（件）",
            "description": "固定规格原样保留到箱级，例如907g/瓶*6瓶/箱；上托数量独立保存"
        },
        "materials": {
            "bsonType": "array",
            "description": "仅材料档案清单；不保存标准用量或损耗系数",
            "items": {
                "bsonType": "object",
                "required": [
                    "materialCode",
                    "unit"
                ],
                "properties": {
                    "seq": {
                        "bsonType": "number",
                        "description": "合并跨页物料后的行序"
                    },
                    "materialCode": {
                        "bsonType": "string",
                        "description": "原样保留物料编号及 -1 后缀"
                    },
                    "materialName": {
                        "bsonType": "string",
                        "description": "物料名称"
                    },
                    "spec": {
                        "bsonType": "string",
                        "description": "完整规格型号，最多2000字符"
                    },
                    "materialVersion": {
                        "description": "印刷版本号原样保存，例如01或N/A；无法识别或无记录为null，不能猜成N/A"
                    },
                    "unit": {
                        "bsonType": "string",
                        "description": "原始计量单位"
                    },
                    "sourcePages": {
                        "bsonType": "array",
                        "description": "来源原图页码1至6；跨页物料可以关联多页，未知为空数组",
                        "items": {
                            "bsonType": "number"
                        }
                    }
                }
            }
        },
        "sourceOrderNo": {
            "bsonType": "string",
            "title": "来源指令单订单号",
            "description": "本清单转录自哪张包装指令单，如 564008，便于回查纸质单据"
        },
        "source": {
            "bsonType": "string",
            "title": "数据来源",
            "description": "manual 手工录入 | import 批量导入 | photo 从纸质指令单照片转录（转录后需人工核对物料编号）"
        },
        "enabled": {
            "bsonType": "boolean",
            "title": "是否启用",
            "description": "停用产品不出现在列表"
        },
        "updatedAt": {
            "bsonType": "number",
            "title": "云端更新时间",
            "description": "写入云端的毫秒时间戳，用于排序"
        },
        "updatedBy": {
            "bsonType": "string",
            "title": "操作人",
            "description": "最近写入的用户 uid"
        },
        "version": {
            "bsonType": "number",
            "title": "版本号",
            "description": "从 1 递增；每次内容变更 +1，配合 product_materials_versions 做历史追溯"
        },
        "sourceDocumentId": {
            "bsonType": "string",
            "description": "不可变原始单据 ID"
        },
        "recognitionRunId": {
            "bsonType": "string",
            "description": "本次实际识别运行 ID"
        },
        "audit": {
            "bsonType": "object",
            "description": "服务端生成：操作人、时间、原因、前后版本及变化字段"
        }
    }
}
